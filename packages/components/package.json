{
  "name": "@govom/components",
  "version": "3.28.1",
  "description": "Oman GUP web components library",
  "type": "module",
  "main": "dist/components.js",
  "module": "./dist/components.js",
  "exports": {
    ".": {
      "import": "./dist/components.js"
    },
    "./autoloader.js": "./dist/autoloader.js",
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:docs": "npx cem analyze",
    "lint:all": "npm run lint:css && npm run lint:ts && npm run lint:lit && npm run lint:eslint && npm run lint:a11y && npm run lint:prettier",
    "lint:css": "npx stylelint .",
    "lint:ts": "tsc --noEmit --skipLibCheck",
    "lint:lit": "lit-analyzer --strict src/components",
    "lint:eslint": "npx eslint .",
    "lint:a11y": "npm run build-storybook && axe-storybook",
    "lint:prettier": "npx prettier . --check",
    "lint:prettier:format": "npx prettier . --write",
    "test:visual": "npx chromatic --exit-zero-on-changes --only-changed",
    "chromatic": "npm run test:visual",
    "preview": "npx http-server . --cors",
    "storybook": "npm run build:docs && storybook dev -p 9483 --no-open",
    "preview-storybook": "npm run build-storybook && npx http-server ./storybook-static --cors",
    "build-storybook": "npm run build:docs && storybook build --stats-json && npm run copy-docs-assets && npm run extract-code && npm run extract-react-code && npm run extract-changelog",
    "extract-changelog": "node scripts/extract-changelog-latest.js",
    "copy-docs-assets": "node scripts/copy-docs-assets.js",
    "extract-code": "node scripts/extract-code-snippets.js",
    "extract-react-code": "node scripts/extract-react-code-snippets.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.3",
    "@fontsource/readex-pro": "^5.0.12",
    "@open-wc/form-control": "^1.0.0",
    "glob": "^11.0.1",
    "lit": "^3.2.1",
    "modern-normalize": "^2.0.0"
  },
  "devDependencies": {
    "@chanzuckerberg/axe-storybook-testing": "^8.2.2",
    "@chromatic-com/storybook": "^3.2.4",
    "@custom-elements-manifest/analyzer": "^0.9.9",
    "@storybook/addon-a11y": "^8.5.3",
    "@storybook/addon-essentials": "^8.5.3",
    "@storybook/addon-interactions": "^8.5.3",
    "@storybook/addon-links": "^8.5.3",
    "@storybook/blocks": "^8.5.3",
    "@storybook/manager-api": "^8.5.3",
    "@storybook/preview-api": "^8.5.3",
    "@storybook/test": "^8.5.3",
    "@storybook/web-components": "^8.5.3",
    "@storybook/web-components-vite": "^8.5.3",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "@whitespace/storybook-addon-html": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "cem-plugin-custom-jsdoc-tags": "^1.1.1",
    "cem-plugin-expanded-types": "^1.3.2",
    "chromatic": "^11.25.2",
    "eslint": "^8.51.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsdoc": "^48.5.0",
    "eslint-plugin-lit": "^1.9.1",
    "eslint-plugin-lit-a11y": "^4.1.1",
    "eslint-plugin-wc": "^2.0.4",
    "husky": "^8.0.0",
    "js-beautify": "^1.15.4",
    "lit-analyzer": "^2.0.1",
    "postcss": "^8.4.31",
    "postcss-dir-pseudo-class": "^8.0.0",
    "postcss-import": "^15.1.0",
    "postcss-lit": "^1.2.0",
    "postcss-mixins": "^9.0.4",
    "postcss-nested": "^6.0.1",
    "postcss-reporter": "^7.0.5",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "rollup-plugin-postcss-lit": "^2.1.0",
    "storybook": "^8.5.3",
    "storybook-addon-rtl": "^1.0.1",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-no-unsupported-browser-features": "^8.0.1",
    "stylelint-use-logical": "^2.1.2",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^5.0.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.0",
    "wc-storybook-helpers": "^2.0.4"
  }
}
